<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Referenced by app/src/main/AndroidManifest.xml -->
    <style name="Theme.AlphaAppStore" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/alpha_background</item>
        <item name="android:navigationBarColor">@color/alpha_background</item>
        <item name="android:windowBackground">@color/alpha_background</item>
    </style>

    <!-- Splash theme. Referenced by app/src/main/AndroidManifest.xml -->
    <style name="Theme.Splash" parent="Theme.AlphaAppStore">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
